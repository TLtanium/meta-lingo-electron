# ===================================
# Meta-Lingo-Electron .gitignore
# ===================================

# ===================================
# macOS System Files
# ===================================
.DS_Store
/public/licenses/
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# ===================================
# Build & Distribution
# ===================================
backend-dist/
/build/
/mcp-extension/build/
backend/build/
backend/dist/
dist/
dist-electron/
release/
*.dmg
*.exe

# ===================================
# Dependencies
# ===================================
node_modules/
.vite/

# ===================================
# ML Models (keep folder structure only)
# ===================================
models/**/*
!models/
!models/models.txt
!models/**/
!models/**/.gitkeep

# ===================================
# Python Wheels
# ===================================
*.whl

# ===================================
# Development & Test Files
# ===================================
PROJECT.md
/*.md
!/README.md
!/LICENSING.md
!/SOURCE.md
!/THIRD_PARTY_NOTICES.md
/docs/
/memory/
/src/**/*.md
/mcp-extension/improvements.md
/language.txt
/excludes.txt
/corpus_building.py
/scripts/antconc_db_to_txt.py
/scripts/convert_frameworks.py
/scripts/corpus_processor.py
/scripts/process_now_oanc.py
/scripts/usas_accuracy_analysis.py
/scripts/usas_accuracy_report.txt
CiteSpace 复刻升级计划.md
**/mldoc.md
pymusas_bem_analysis.md
pymusas_bem_test_results.txt
pymusas_output_example.md
pymusas_topn_analysis.md
pymusas_topn_comparison.txt
rules.md
spacy_tags_test_report.md
spacy_tags.tsv
usas_semantic_domains.txt
test_*.py
!/scripts/test_*.py
export_spacy_tags.py

# ===================================
# PDF Documents
# ===================================
*.pdf

# ===================================
# Config & Build Scripts (optional, for dev only)
# Build outputs and private local scripts are omitted; required build inputs are included below.
# Private root scripts remain local; build/development inputs are allowed below.
# ===================================
build.sh
build.bat
dev.sh
dev-backend.sh
dev-frontend.sh
start.sh
push.sh
# Root scripts are private unless explicitly allowed below.
/*.sh
/*.bat
/*.command
/*.ps1
index.html
vite.config.ts
electron-builder.json
package-lock.json
tsconfig.json
tsconfig.node.json
.npmrc

# ===================================
# Data Files (keep structure only)
# ===================================
/data/
data/corpora/
data/annotations/
data/topic_modeling/
data/word2vec_models/
data/*.sqlite
data/*.db

# ===================================
# Dictionary Files (too large for GitHub)
# ===================================
saves/dict/*.json

# ===================================
# Corpus data (generated/large CSVs - OANC, BNC, etc.)
# ===================================
saves/corpus/

# ===================================
# Downloaded/runtime model cache
# ===================================
saves/models/**

# ===================================
# JSON Data Files (specific)
# ===================================
master_metaphor_lexicon.json
metaphor_filter.json
mipvu_demonstratives.json
mipvu_prepositions.json

# ===================================
# Python Cache
# ===================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# ===================================
# IDE & Editor
# ===================================
.idea/
.vscode/
*.swp
*.swo
*~

# ===================================
# Logs
# ===================================
*.log
npm-debug.log*

# ===================================
# Environment
# ===================================
.env
.env.local
.env.*.local

# ===================================
# Temporary Files
# ===================================
tmp/
temp/
*.tmp

# ===================================
# Claude Code
# ===================================
.claude/

# Generated private development plugin (contains machine-specific interpreter paths)
/data/openai-plugin-dev/

# User resources are private and must never be distributed.
/saves/nrc/
/saves/dict/
/saves/.cache/
/data/user_resources/
/backend/data/
*.mdx
*.mdd
# Required corresponding source and build inputs (AGPL).
!/build.sh
!/build.bat
!/build-extension.sh
!/build-extension.bat
!/dev.sh
!/dev-backend.sh
!/dev-frontend.sh
!/start.sh
!/index.html
!/vite.config.ts
!/electron-builder.json
!/package-lock.json
!/tsconfig.json
!/tsconfig.node.json
!/usas_semantic_domains.txt

# Local authorship/disclosure records; never publish automatically.
/private-ip-records/

# Local tools, generated reports, caches and operating-system state.
/.agents/
/.codex/
/.claude/
/.cache/
/coverage/
*.tsbuildinfo
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.toc
*.pyz
*.pkg
*.dSYM/
Thumbs.db
Desktop.ini
